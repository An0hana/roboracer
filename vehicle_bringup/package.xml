  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ackermann_wheel_odom</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>local_costmap</exec_depend>
  <exec_depend>manual_ctrl</exec_depend>
  <exec_depend>mppi_controller</exec_depend>
  <exec_depend>opponent_tracker</exec_depend>
  <exec_depend>pose_odom</exec_depend>
