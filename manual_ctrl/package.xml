<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>manual_ctrl</name>
  <version>0.1.0</version>
  <description>
    Gamepad manual control with a latching exclusive takeover for an F1TENTH
    car. Press X to stop the car and seize control through a command mux that
    locks out all autonomous command sources; press X again to release.
  </description>
  <maintainer email="seeed@todo.todo">seeed</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-evdev</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
