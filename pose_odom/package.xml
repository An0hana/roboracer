<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pose_odom</name>
  <version>0.1.0</version>
  <description>
    Odometry from Cartographer tracked_pose (position and orientation) fused
    with VESC motor RPM (speed). Motor RPM is the primary speed source; the
    tracked_pose derivative supplies direction and a slow scale correction.
  </description>
  <maintainer email="seeed@todo.todo">seeed</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>vesc_msgs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
